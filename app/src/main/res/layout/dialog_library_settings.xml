<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/filter_title"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbFilterHd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filter_hd" />

            <RadioButton
                android:id="@+id/rbFilterSmooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filter_smooth" />

            <RadioButton
                android:id="@+id/rbFilterOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filter_off" />
        </RadioGroup>

        <Switch
            android:id="@+id/swFluid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/fluid_title" />

        <Switch
            android:id="@+id/swJoystick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/joystick_title" />

        <Switch
            android:id="@+id/swShowFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/show_fps_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/orientation_title"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spOrientation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
